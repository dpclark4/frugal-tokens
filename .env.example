OPENCODE_DB_PATH=~/.local/share/opencode/opencode.db
CLAUDE_CODE_PROJECT_PATH=~/.claude/projects
PI_SESSION_DIR=~/.pi/agent/sessions
CODEX_SESSION_DIR=~/.codex/sessions
CURSOR_CHATS_PATH=~/.cursor/chats
# Optional; the importer also checks the historical /tmp location.
# CURSOR_SSE_CAPTURE_DIR=~/.local/share/frugal-tokens/cursor-capture
FRUGAL_TOKENS_DATABASE_URL=sqlite:~/.local/share/frugal-tokens/archive.sqlite
# Optional: periodically import changed sessions; unset or 0 keeps boot-only sync.
# FRUGAL_TOKENS_SYNC_INTERVAL_SECONDS=30
# Optional: override the API server port; defaults to 9000.
# FRUGAL_TOKENS_API_PORT=9000
