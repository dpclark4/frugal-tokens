{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "files": [
    "src/server/main.ts",
    "src/client/main.tsx",
    "vite.config.ts",
    "scripts/dev.ts",
    "scripts/runDbmate.ts",
    "scripts/prepareDatabase.ts"
  ],
  "include": [
    "src/**/*.test.ts",
    "src/test/**/*.ts",
    "scripts/**/*.test.ts",
    "scripts/runHttpTests.ts",
    "tools/**/*.test.ts",
    "e2e/**/*.ts",
    "vitest.config.ts"
  ]
}
