{
  "name": "frugal-tokens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "setup": "deno task setup",
    "check": "tsc --project tsconfig.node.json --noEmit",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:gate": "oxlint --config .oxlintrc.prek.json --quiet .",
    "test": "deno task test",
    "test:e2e": "deno task test:e2e",
    "db:new": "node --import tsx scripts/runDbmate.ts new",
    "db:migrate": "node --import tsx scripts/prepareDatabase.ts && node --import tsx scripts/runDbmate.ts --no-dump-schema up",
    "db:rollback": "node --import tsx scripts/runDbmate.ts down",
    "db:status": "node --import tsx scripts/runDbmate.ts status",
    "demo:db:create": "deno task demo:db:create",
    "dev": "node --import tsx scripts/dev.ts",
    "dev:server": "node --env-file=.env --import tsx scripts/prepareDatabase.ts && node --env-file=.env --import tsx scripts/runDbmate.ts --no-dump-schema up && tsx watch --include 'src/server/**' --include 'src/shared/**' --env-file=.env src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "export SERVE_STATIC=true && node --env-file=.env --import tsx scripts/prepareDatabase.ts && node --env-file=.env --import tsx scripts/runDbmate.ts --no-dump-schema up && node --env-file=.env --import tsx src/server/main.ts",
    "start:api": "pnpm db:migrate && node --import tsx src/server/main.ts",
    "demo:deploy:frontend": "deno task demo:deploy:frontend",
    "demo:deploy:backend": "deno task demo:deploy:backend",
    "demo:deploy:data": "deno task demo:deploy:data"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@tanstack/react-router": "1.170.17",
    "dbmate": "2.34.1",
    "hono": "4.12.29",
    "html-to-image": "1.11.13",
    "lucide-react": "1.25.0",
    "pretty-ms": "9.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.3.0",
    "tsx": "4.23.15",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "wrangler": "4.112.0"
  }
}
